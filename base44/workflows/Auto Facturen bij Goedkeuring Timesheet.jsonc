{
  "name": "Auto Facturen bij Goedkeuring Timesheet",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"approved\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Timesheet"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_facturen_bij_goedkeuring_timesheet",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onTimesheetApproved",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onTimesheetApproved"
  }
}