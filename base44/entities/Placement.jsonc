{
  "name": "Placement",
  "type": "object",
  "properties": {
    "placement_type": {
      "type": "string",
      "enum": [
        "freelancer",
        "perm"
      ],
      "default": "freelancer",
      "description": "Type placement: freelancer of PERM (vaste aanwerving)"
    },
    "consultant_first_name": {
      "type": "string",
      "description": "Voornaam consultant"
    },
    "consultant_last_name": {
      "type": "string",
      "description": "Achternaam consultant"
    },
    "job_title": {
      "type": "string",
      "description": "Functietitel consultant (bijv. Data Analist, Data Engineer)"
    },
    "job_description": {
      "type": "string",
      "description": "Functieomschrijving in woorden \u2013 wordt gekopieerd naar het contract"
    },
    "consultant_company_name": {
      "type": "string",
      "description": "Bedrijfsnaam consultant (freelancers)"
    },
    "consultant_company_address": {
      "type": "string",
      "description": "Adres bedrijf consultant"
    },
    "consultant_vat_number": {
      "type": "string",
      "description": "BTW nummer consultant"
    },
    "consultant_personal_address": {
      "type": "string",
      "description": "Persoonlijk adres consultant"
    },
    "consultant_contact_name": {
      "type": "string",
      "description": "Naam contactpersoon consultant"
    },
    "consultant_contact_email": {
      "type": "string",
      "description": "E-mail contactpersoon consultant"
    },
    "consultant_contact_phone": {
      "type": "string",
      "description": "Telefoon contactpersoon consultant"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Startdatum placement"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Einddatum placement (origineel)"
    },
    "extensions": {
      "type": "array",
      "description": "Verlengingen van het contract",
      "items": {
        "type": "object",
        "properties": {
          "extended_on": {
            "type": "string",
            "format": "date"
          },
          "new_end_date": {
            "type": "string",
            "format": "date"
          },
          "consultant_rate": {
            "type": "number"
          },
          "client_rate": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "days_per_week": {
      "type": "number",
      "default": 5
    },
    "consultant_rate": {
      "type": "number",
      "description": "Dagtarief consultant (EUR)"
    },
    "client_rate": {
      "type": "number",
      "description": "Dagtarief klant (EUR)"
    },
    "agoria_index_client": {
      "type": "number"
    },
    "agoria_index_consultant": {
      "type": "number"
    },
    "payment_terms_client": {
      "type": "integer",
      "description": "Betalingstermijn klant in dagen (bijv. 30)"
    },
    "payment_terms_consultant": {
      "type": "integer",
      "description": "Betalingstermijn consultant in dagen (bijv. 30)"
    },
    "notice_period_client": {
      "type": "string",
      "description": "Opzegtermijn klant (bijv. 30 dagen)"
    },
    "notice_period_consultant": {
      "type": "string",
      "description": "Opzegtermijn consultant (bijv. 30 dagen)"
    },
    "liability_limit": {
      "type": "string",
      "description": "Aansprakelijkheidsbeperking"
    },
    "payroll_number": {
      "type": "string",
      "description": "Payrollnummer van de consultant"
    },
    "perm_annual_salary": {
      "type": "number"
    },
    "perm_fee_percentage": {
      "type": "number",
      "default": 20
    },
    "perm_fee_amount": {
      "type": "number"
    },
    "sales_contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "percentage": {
            "type": "number"
          }
        }
      }
    },
    "client_company_name": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "client_vat_number": {
      "type": "string"
    },
    "client_billing_email": {
      "type": "string"
    },
    "client_timesheet_approver_email": {
      "type": "string",
      "description": "E-mailadres van de persoon die timesheets controleert bij de klant"
    },
    "reference_instructions": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "Extra opmerkingen bij placement"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended",
        "on_hold"
      ],
      "default": "active"
    },
    "vincere_id": {
      "type": "string"
    },
    "contract_template_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Geselecteerde contractsjablonen"
    },
    "invoice_template_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Geselecteerde factuursjablonen"
    }
  },
  "required": [
    "consultant_first_name",
    "consultant_last_name",
    "client_company_name",
    "start_date"
  ]
}